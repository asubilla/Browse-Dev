{
	"$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
	"name": "com.browse-dev/browse-dev",
	"description": "Browser agents and stealth cloud browsers for AI: run web tasks, fill forms, extract data.",
	"repository": {
		"url": "https://github.com/asubilla/Browse-Dev",
		"source": "github"
	},
	"websiteUrl": "https://github.com/asubilla/Browse-Dev",
	"version": "1.0.6",
	"packages": [
		{
			"registryType": "pypi",
			"registryBaseUrl": "https://pypi.org",
			"identifier": "browse-dev",
			"version": "1.0.6",
			"runtimeHint": "uvx",
			"packageArguments": [
				{
					"type": "positional",
					"value": "--cli-mcp"
				}
			],
			"transport": {
				"type": "stdio"
			}
		}
	],
	"remotes": [
		{
			"type": "streamable-http",
			"url": "https://api.browser-use.com/v3/mcp",
			"headers": [
				{
					"name": "X-Browser-Use-API-Key",
					"description": "Browse Dev Cloud API key from https://cloud.browser-use.com/settings",
					"isRequired": true,
					"isSecret": true
				}
			]
		}
	]
}
